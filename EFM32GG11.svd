          <resetValue>0x00000000</resetValue>
          <resetMask>0x017700FF</resetMask>
          <fields>
            <field>
              <name>TCMPVAL</name>
              <description>Timer Comparator 0</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
