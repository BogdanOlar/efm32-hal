                  <value>0x00000000</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TXST</name>
                  <description>Comparator 0 is disabled at the start of transmission</description>
                  <value>0x00000001</value>
                </enumeratedValue>
